BOT_TOKEN=YOUR_BOT_TOKEN
CLIENT_ID=YOUR_APPLICATION_ID
GUILD_ID=YOUR_SERVER_ID

# Railway PostgreSQL connection string.
# Leave blank for temporary in-memory mode during local testing.
DATABASE_URL=

# Optional: only enable if your PostgreSQL provider requires SSL.
DATABASE_SSL=false

# Optional category ID. If blank, the bot creates/uses "Buckshot Tickets".
TICKET_CATEGORY_ID=

# Optional turn timeout in seconds. Default: 120.
TURN_TIMEOUT_SECONDS=120
# Envy connection for money-backed Buckshot.
ENVY_API_URL=https://your-envy-service.example.com
ENVY_API_KEY=replace_with_the_same_secret_used_by_Envy
PRIDE_API_URL=https://your-pride-service.up.railway.app
PRIDE_API_KEY=use_the_same_secret_as_Pride
